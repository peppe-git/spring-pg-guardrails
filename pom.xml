<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.peppe-git</groupId>
    <artifactId>spring-pg-guardrails-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>spring-pg-guardrails (parent)</name>
    <description>Fail-closed PostgreSQL Row-Level Security for Spring, plus executable guards that prove it holds.</description>
    <url>https://github.com/peppe-git/spring-pg-guardrails</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>peppe-git</id>
            <name>Giuseppe Picciocchi</name>
            <url>https://github.com/peppe-git</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/peppe-git/spring-pg-guardrails.git</connection>
        <developerConnection>scm:git:https://github.com/peppe-git/spring-pg-guardrails.git</developerConnection>
        <url>https://github.com/peppe-git/spring-pg-guardrails</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/peppe-git/spring-pg-guardrails/issues</url>
    </issueManagement>

    <modules>
        <module>pg-rls-core</module>
        <module>spring-pg-guardrails</module>
        <module>pg-rls-test</module>
        <module>examples/rls-demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 17 is the baseline of both Spring Boot 3 and 4; nothing here needs 21. -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- The BOM we compile and test against. The `boot3` profile switches it. -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <archunit.version>1.5.1</archunit.version>

        <!-- Docker image used by every Testcontainers test in this build. -->
        <postgres.image>postgres:17-alpine</postgres.image>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.peppe-git</groupId>
                <artifactId>pg-rls-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.peppe-git</groupId>
                <artifactId>spring-pg-guardrails</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.peppe-git</groupId>
                <artifactId>pg-rls-test</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial,-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <systemPropertyVariables>
                            <pg.image>${postgres.image}</pg.image>
                        </systemPropertyVariables>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                        <trimStackTrace>false</trimStackTrace>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.12.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Publication to Maven Central: sources, javadoc, signatures, upload. Only with -Prelease.
             Locally: ./mvnw -Prelease -Dgpg.skip -DskipTests verify
             The signer is Bouncy Castle: it reads the armored secret key from MAVEN_GPG_KEY and the passphrase from
             MAVEN_GPG_PASSPHRASE, so no gpg executable is needed. Credentials for the upload come from the
             settings.xml server "central". autoPublish is false: every deployment is confirmed by hand in the
             Central Portal. -->
        <profile>
            <id>release</id>
            <properties>
                <central.skipUpload>false</central.skipUpload>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <release>${maven.compiler.release}</release>
                            <detectJavaApiLink>false</detectJavaApiLink>
                            <!-- Every doclint check except "missing comment": a broken reference or malformed
                                 HTML fails the release, an undocumented getter does not. -->
                            <doclint>all,-missing</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <signer>bc</signer>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <skipUpload>${central.skipUpload}</skipUpload>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Runs the whole build against the last Spring Boot 3 line (Spring Framework 6.2, Hibernate 6.6):
             ./mvnw verify -Dboot3 -->
        <profile>
            <id>boot3</id>
            <activation>
                <property>
                    <name>boot3</name>
                </property>
            </activation>
            <properties>
                <spring-boot.version>3.5.16</spring-boot.version>
            </properties>
        </profile>
    </profiles>
</project>
